  "colorMaps": {
    "light": {
      "description": "Color scheme for light theme",
      "brandPrimary": "#004B87",
      "brandSecondary": "#00BCD4",
      "textPrimary": "#333333",
      "textSecondary": "#E8E8E8",
      "textOnPrimary": "#FFFFFF",
      "textOnDark": "#FFFFFF",
