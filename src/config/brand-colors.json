  "accessibility": {
    "wcagStandards": {
      "AA": "4.5:1 contrast ratio for text",
      "AAA": "7:1 contrast ratio for text"
    },
    "validContrasts": [
      {
        "pair": "Navy + White",
        "ratio": "18.5:1",
        "level": "AAA"
      },
      {
        "pair": "Navy + Light Gray",
        "ratio": "10.2:1",
        "level": "AAA"
      },
      {
        "pair": "Cyan + White",
        "ratio": "6.3:1",
        "level": "AAA"
      },
      {
        "pair": "Cyan + Dark Gray",
        "ratio": "8.1:1",
        "level": "AAA"
      }
    ],
    "combinationsToAvoid": [
      {
        "pair": "Navy + Cyan",
        "ratio": "2.8:1",
        "reason": "Insufficient contrast, not suitable for text"
      }
    ]
  },

  "cssVariables": {
    "description": "CSS custom properties for color values",
    "format": "--color-{colorName}",
    "example": {
      "--color-primary-navy": "#004B87",
      "--color-primary-cyan": "#00BCD4",
      "--color-neutral-white": "#FFFFFF",
      "--color-neutral-light-gray": "#F5F5F5",
      "--color-neutral-dark-gray": "#333333",
      "--color-semantic-success": "#4CAF50",
      "--color-semantic-error": "#F44336",
      "--color-text-primary": "#333333",
      "--color-button-primary": "#004B87",
      "--color-bg-primary": "#FFFFFF",
      "--color-border": "#E8E8E8"
    }
  },

  "guidelines": {
    "rule1": "Navy (#004B87) is the main brand color. Use it for primary UI elements.",
    "rule2": "Cyan (#00BCD4) is the accent color. Use it for secondary actions and highlights.",
    "rule3": "Maintain WCAG AA contrast ratios (4.5:1) minimum for all text.",
    "rule4": "Each demonstration has its own color palette. Do not mix with BAJA WEB CO. colors.",
    "rule5": "Use Light Gray (#F5F5F5) for subtle backgrounds and separators.",
    "rule6": "Dark Gray (#333333) is the default text color for readability.",
    "rule7": "Never use Navy + Cyan together for text/background pairs.",
    "rule8": "Preserve the original logo colors. Create variants for dark/light contexts."
  },

  "references": {
    "brandGuide": "docs/brand-guidelines.md",
    "designTokens": "src/config/design-tokens.json",
    "colorPalette": "src/config/brand-colors.json",
    "typography": "src/config/brand-typography.json",
    "auditReport": "BRAND_AUDIT_REPORT.md"
  }
